# ═══════════════════════════════════════════════════════
# Laclarc Backend — .gitignore
# المبدأ: السرّ لا يعيش في Git — Render env فقط
# ═══════════════════════════════════════════════════════

# ─── 🔐 P0: Environment — السرّ الحقيقي ───
.env
.env.*
.env.local
!.env.example

# ─── Dependencies ───
node_modules/

# ─── Logs ───
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── 🧰 أدوات الورشة المحلية (local only — لا تدخل الـ repo) ───
test_*.js
fix_*.js
audit_*.js
debug_*.js
rescue_*.js
cleanup_*.js
diagnose_*.js
preflight_*.js
preflight_check_*.js
load_test_*.js
resend_*.js
check_*.js
prep_*.js
show_*.js
stop_*.js
# ─── Backups ───
*.bak
*.bak2
*~

# ─── Temp / Cache ───
tmp/
temp/
.cache/

# ─── Coverage / Test artifacts ───
coverage/
.nyc_output/

# ─── OS junk ───
.DS_Store
Thumbs.db
desktop.ini

# ─── Editors ───
.idea/
.vscode/

# ─── Node internals ───
.npm/
.node_repl_history*.bak-xchg
*.bak-xchg
*.bak-xchg
